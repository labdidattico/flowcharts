  "functions": [],
  "id": "esempio_completo",
  "main": {
    "name": "main",
    "parameters": [],
    "rawId": "main",
    "statements": [
      {
        "@type": "Begin",
        "id": "inizio"
      },
      {
        "@type": "Declare",
        "id": "dic_n",
        "initValue": "0",
        "lengthValue": -1,
        "lengthValue1": "5",
        "lengthValue2": "5",
        "name": "n",
        "tpe": "Integer"
      },
      {
        "@type": "Declare",
        "id": "dic_somma",
        "initValue": "0",
        "lengthValue": -1,
        "lengthValue1": "5",
        "lengthValue2": "5",
        "name": "somma",
        "tpe": "Integer"
      },
      {
        "@type": "Input",
        "id": "leggi_n",
        "name": "n",
        "prompt": "Quanti numeri"
      },
      {
        "@type": "If",
        "condition": "n > 0",
        "falseBlock": {
          "id": "ramo_falso",
          "statements": [
            {
              "@type": "Assign",
              "id": "ass_n",
              "name": "n",
              "value": "1"
            }
          ]
        },
        "id": "se_positivo",
        "trueBlock": {
          "id": "ramo_vero",
          "statements": [
            {
              "@type": "Output",
              "id": "out_vero",
              "newline": true,
              "value": "\"Inizio elaborazione\""
            }
          ]
        }
      },
      {
        "@type": "ForLoop",
        "body": {
          "id": "corpo_for",
          "statements": [
            {
              "@type": "Assign",
              "id": "acc",
              "name": "somma",
              "value": "somma + i"
            },
            {
              "@type": "Output",
              "id": "out_for",
              "newline": true,
              "value": "i"
            }
          ]
        },
        "condition": "i <= n",
        "id": "ciclo_for",
        "init": "i = 1",
        "update": "i = i + 1"
      },
      {
        "@type": "While",
        "body": {
          "id": "corpo_while",
          "statements": [
            {
              "@type": "Assign",
              "id": "dim",
              "name": "somma",
              "value": "somma - 10"
            }
          ]
        },
        "condition": "somma > 10",
        "id": "ciclo_while"
      },
      {
        "@type": "DoWhile",
        "body": {
          "id": "corpo_dowhile",
          "statements": [
            {
              "@type": "Assign",
              "id": "inc",
              "name": "somma",
              "value": "somma + 1"
            }
          ]
        },
        "condition": "somma < 3",
        "id": "ciclo_dowhile"
      },
      {
        "@type": "Output",
        "id": "out_fine",
        "newline": true,
        "value": "somma"
      },
      {
        "@type": "Return",
        "id": "fine",
        "maybeValue": null
      }
    ],
    "tpe": "Void"
  },
  "name": "Esempio completo - tutti i blocchi",
  "revision": 1,
  "version": "0.3"
